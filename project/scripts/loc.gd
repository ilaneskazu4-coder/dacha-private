static func set_lang(code: String) -> void:
	var ru_like := ["ru", "be", "kk", "uk", "uz", "hy", "az", "ka", "tg", "tk", "ky", "mo", "tt"]
	en = not (code.substr(0, 2).to_lower() in ru_like)
	_cache.clear()


static func t(s: String) -> String:
	if not en or s == "":
		return s
	if _cache.has(s):
		return _cache[s]
	var r := s
	if _all.is_empty():
		_all = PAIRS.duplicate()
		_all.append_array(LocExtra.PAIRS)
		_all.sort_custom(func(a, b): return a[0].length() > b[0].length())
	for p in _all:
		if r.contains(p[0]):
			r = r.replace(p[0], p[1])
	r = r.replace("«", "\"").replace("»", "\"")
	_cache[s] = r
	return r
